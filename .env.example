# ==============================================================================
# Blockchain-Based College Club Expense Tracker
# Environment Configuration Template (.env.example)
#
# INSTRUCTIONS:
# 1. Copy this file to '.env' (do NOT commit your real .env file!).
# 2. Fill in the values below.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Ethereum Sepolia Testnet Settings
# ------------------------------------------------------------------------------
# Sepolia RPC URL (Use Alchemy, Infura, or public Sepolia RPC)
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Deployer wallet private key (WITHOUT 0x prefix or with 0x prefix, 64 hex characters)
# IMPORTANT: For academic demo, use a TEST WALLET with only Sepolia testnet ETH.
# NEVER USE A REAL MAINNET WALLET WITH REAL FUNDS.
SEPOLIA_PRIVATE_KEY=your_sepolia_wallet_private_key_here

# Deployed Smart Contract Address on Sepolia (filled after running deploy script)
# Example: 0x1234567890123456789012345678901234567890
CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000

# Initial Club Budget in paise (Default: 10,000 INR = 1,000,000 paise)
INITIAL_BUDGET_PAISE=1000000

# ------------------------------------------------------------------------------
# 2. Supabase PostgreSQL Database Settings
# ------------------------------------------------------------------------------
# Find these in Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co

# Public anon key (Used on frontend for read-only access)
SUPABASE_ANON_KEY=eyJhbGciOi...

# Secret service_role key (ONLY used in /api/sync Vercel serverless function, NEVER in browser)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

