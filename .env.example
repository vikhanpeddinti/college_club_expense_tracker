# ==============================================================================
# Blockchain-Based College Club Expense Tracker - Environment Configuration
# ==============================================================================

# 1. Ethereum Sepolia Network & RPC
# Public RPC endpoint used by frontend on load (no wallet popup required) and Hardhat
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# 2. Dual-Account Maker-Checker Architecture (Mandatory Separation of Duties)
# Primary Account: Contract Deployer & Approver (Club Faculty / President)
# - Deploys the ClubExpenseTracker contract
# - Authoritatively approves or rejects submitted expenses
# - Forbidden by smart contract from approving its own submissions
SEPOLIA_PRIVATE_KEY=your_primary_deployer_approver_private_key_without_0x

# Secondary Account: Club Member Submitter / Maker (Student / Committee Member)
# - Submits demo expense proposals on-chain
# - Funded with SepoliaETH via scripts/fundAccount.cjs
APPROVER_2_ADDRESS=0x0000000000000000000000000000000000000000
APPROVER_2_PRIVATE_KEY=your_secondary_club_member_maker_private_key_without_0x

# 3. Smart Contract Deployment Parameters
# Deployed contract address on Ethereum Sepolia
CONTRACT_ADDRESS=0x96a9d4B3eD9ca573c53bb7066437D0278133DB12
# Initial budget in integer paise (e.g., 5000000 paise = 50,000 INR)
INITIAL_BUDGET_PAISE=5000000

# 4. Supabase PostgreSQL Off-Chain Mirror Database
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_public_key
# Kept strictly server-side for authenticated API sync endpoints
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# 5. Multi-Wallet Connectors (Optional for WalletConnect Modal)
WALLETCONNECT_PROJECT_ID=your_reown_cloud_walletconnect_project_id
